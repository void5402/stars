{
    "version": 8,
    "configurePresets": [
        {
            "name": "base",
            "displayName": "default placeholder",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/cmake"
        },
        {
            "name": "gcc-compiler",
            "displayName": "configure for gcc",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "gcc",
            "configurePreset": "gcc-compiler"
        }
    ]
}